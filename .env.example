# Chave da API Pública do DataJud/PDPJ (CNJ).
# O valor abaixo é a chave pública divulgada pelo próprio CNJ na documentação oficial
# (https://datajud-wiki.cnj.jus.br/api-publica/acesso). Troque pela sua se possuir outra.
PDPJ_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Endereço base da API (só mude para apontar para um proxy ou ambiente de teste)
PDPJ_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Base da API de comunicações do DJEN (Diário de Justiça Eletrônico Nacional).
# Aberta, sem chave: é de onde saem advogados, partes e auxiliares da justiça.
PDPJ_DJEN_URL=https://comunicaapi.pje.jus.br

# Tempo de cache das consultas, em segundos (0 desativa)
PDPJ_CACHE_TTL=300

# Tempo limite das chamadas à API, em milissegundos.
# A API pública do DataJud é lenta: uma busca por classe no índice do TJSP pode
# levar quase um minuto. 30s derrubava consultas que teriam respondido.
PDPJ_TIMEOUT=90000

# Modo demonstração: responde com uma fixture local, sem nenhuma chamada de rede.
# Útil para conhecer as ferramentas ou testar em ambiente sem acesso ao CNJ.
# PDPJ_DEMO=1
